{
  "name": "@nuva-edu/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos e clientes HTTP do nuva-edu, gerados dos contratos OpenAPI da admin-api e da classroom-api.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin.ts",
    "./classroom": "./src/classroom.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit -p packages/api-client/tsconfig.json",
    "test": "node scripts/check.mjs && vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
