    "playwright-core": "1.65.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "mailparser": "3.15.0",
    "smtp-server": "3.21.7",
    "unpdf": "2.2.2",
    "vitest": "5.1.1"
  }
}
