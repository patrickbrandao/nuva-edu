# nuva-edu — valores padrão NÃO secretos. Este arquivo vai para o Git.
# Senhas e chaves não têm padrão: defina-as em .env.local (fora do Git). Veja .env.example.

# Endereços
NUVA_DOMAIN=localhost
# Os hosts dos sites derivam de NUVA_DOMAIN (edu-admin.<domínio> e classroom.<domínio>).
# Defina NUVA_ADMIN_HOST e NUVA_CLASSROOM_HOST no .env.local só quando fugirem desse formato.
NUVA_CURRENCY=BRL
NUVA_LOCALE=pt-BR

# PostgreSQL
POSTGRES_DB=nuva_edu
POSTGRES_USER=nuva_edu
NUVA_POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB

# Proxy reverso
TRAEFIK_NETWORK=nuva-edu-proxy
TRAEFIK_NETWORK_EXTERNAL=false
TRAEFIK_ENTRYPOINTS=web
TRAEFIK_CERTRESOLVER=
TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443
# Vazio: lista padrão (privadas, CGNAT, laço local, link-local). Para restringir, veja .env.example.
TRUSTED_PROXIES=

# E-mail (padrão de desenvolvimento: Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=nuva-edu <no-reply@localhost>
MAILPIT_UI_PORT=8025

# Limites dos contêineres (ambientes pequenos)
NUVA_POSTGRES_CPUS=1
NUVA_POSTGRES_MEMORY=1g
NUVA_TRAEFIK_CPUS=1
NUVA_TRAEFIK_MEMORY=128m
NUVA_MAILPIT_CPUS=1
NUVA_MAILPIT_MEMORY=64m
NUVA_MIGRATE_CPUS=1
NUVA_MIGRATE_MEMORY=256m
NUVA_ADMIN_API_CPUS=1
NUVA_ADMIN_API_MEMORY=384m
NUVA_CLASSROOM_API_CPUS=1
NUVA_CLASSROOM_API_MEMORY=512m
NUVA_WORKER_CPUS=1
NUVA_WORKER_MEMORY=384m
NUVA_ADMIN_CPUS=1
NUVA_ADMIN_MEMORY=64m
NUVA_CLASSROOM_CPUS=1
NUVA_CLASSROOM_MEMORY=64m

# Logs dos contêineres
NUVA_LOG_MAX_SIZE=10m
NUVA_LOG_MAX_FILE=5

# URLs públicas, imagens e logs da aplicação
NUVA_PUBLIC_SCHEME=http
NUVA_PUBLIC_PORT=8080
NUVA_IMAGE_TAG=latest
NUVA_LOG_LEVEL=info
TRAEFIK_ACME_EMAIL=admin@example.com
