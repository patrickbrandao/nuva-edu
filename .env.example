# Copie para .env.local e preencha. O .env.local fica fora do Git.
# Os valores não secretos e seus padrões estão em .env; a lista completa, na spec 031.

# Obrigatórios
POSTGRES_PASSWORD=
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mail (dispensável com o Mailpit em desenvolvimento)
SMTP_USER=
SMTP_PASSWORD=

# Mercado Pago (a partir da Fase 3; use credenciais de teste fora de produção)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Login social (a partir da Fase 1; deixe vazio para desligar o provedor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Servidor com Traefik já instalado (exemplo do ambiente de teste)
# NUVA_DOMAIN=opencode.tmsoft.com.br
# NUVA_ADMIN_HOST=edu-admin.opencode.tmsoft.com.br
# NUVA_CLASSROOM_HOST=classroom.opencode.tmsoft.com.br
# TRAEFIK_NETWORK=network_public
# TRAEFIK_NETWORK_EXTERNAL=true
# TRAEFIK_ENTRYPOINTS=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt

# Deploy no servidor de testes (usado só pelo `pnpm deploy:test`)
NUVA_DEPLOY_SSH_USER=
NUVA_DEPLOY_SSH_HOST=
NUVA_DEPLOY_SSH_PORT=

# Caminho local do projeto minui-react (usado só para copiar componentes para packages/ui)
NUVA_MINUI_SRC=
