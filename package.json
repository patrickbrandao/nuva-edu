{
  "name": "nuva-edu",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de cursos online instalável: admin, classroom, vendas, fórum e MCP.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare": "node -e \"process.exit(process.env.NUVA_SKIP_GIT_HOOKS?0:1)\" || lefthook install",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "typecheck": "pnpm -r --if-present run typecheck",
    "verify:quick": "node scripts/verify.mjs quick",
    "verify:full": "node scripts/verify.mjs full",
    "licenses:check": "node scripts/check-licenses.mjs",
    "db:migrate": "pnpm --filter @nuva-edu/database run migrate",
    "compose": "node scripts/dev.mjs compose",
    "dev:up": "node scripts/dev.mjs up",
    "dev:down": "node scripts/dev.mjs down",
    "task:start": "node scripts/task.mjs start",
    "task:finish": "node scripts/task.mjs finish",
    "task:abort": "node scripts/task.mjs abort",
    "task:path": "node scripts/task.mjs path",
    "task:list": "node scripts/task.mjs list",
    "deploy:test": "bash scripts/deploy-test.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@nuva-edu/database": "workspace:*",
    "@testcontainers/postgresql": "12.2.2",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
