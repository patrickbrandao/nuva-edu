{
  "name": "nuva-edu",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de cursos online instalável: admin, classroom, vendas, fórum e MCP.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "typecheck": "pnpm -r --if-present run typecheck",
    "verify:quick": "node scripts/verify.mjs quick",
    "verify:full": "node scripts/verify.mjs full",
    "db:migrate": "pnpm --filter @nuva-edu/database run migrate",
    "compose": "node scripts/dev.mjs compose",
    "dev:up": "node scripts/dev.mjs up",
    "dev:down": "node scripts/dev.mjs down",
    "deploy:test": "node scripts/pending.mjs deploy:test 016"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@nuva-edu/database": "workspace:*",
    "@testcontainers/postgresql": "12.2.2",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  }
}
